{
  "info": {
    "name": "SplitUp API",
    "description": "Postman collection for SplitUp backend flow (Auth -> Groups -> Expenses -> Balances -> AI Parse -> Settlements -> Webhook).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "groupId", "value": "" },
    { "key": "memberUserId", "value": "" },
    { "key": "expenseId", "value": "" },
    { "key": "settlementId", "value": "" },
    { "key": "stripeSignature", "value": "replace_with_valid_stripe_signature" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login success', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "  pm.collectionVariables.set('token', data.token);",
                  "}",
                  "if (data.user && data.user.id) {",
                  "  pm.collectionVariables.set('userId', data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Groups",
      "item": [
        {
          "name": "Create Group",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Group created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.group && data.group.id) {",
                  "  pm.collectionVariables.set('groupId', data.group.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Goa Trip\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/groups",
              "host": ["{{baseUrl}}"],
              "path": ["api", "groups"]
            }
          }
        },
        {
          "name": "List My Groups",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/groups",
              "host": ["{{baseUrl}}"],
              "path": ["api", "groups"]
            }
          }
        },
        {
          "name": "Get Group By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "groups", "{{groupId}}"]
            }
          }
        },
        {
          "name": "Add Member",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{memberUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "groups", "{{groupId}}", "members"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Expenses",
      "item": [
        {
          "name": "Create Expense",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expense created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "if (data.expense && data.expense.id) {",
                  "  pm.collectionVariables.set('expenseId', data.expense.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 900,\n  \"category\": \"Transport\",\n  \"description\": \"Airport cab\",\n  \"splits\": [\n    { \"userId\": \"{{userId}}\", \"share\": 450 },\n    { \"userId\": \"{{memberUserId}}\", \"share\": 450 }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}/expenses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "groups", "{{groupId}}", "expenses"]
            }
          }
        },
        {
          "name": "List Expenses",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}/expenses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "groups", "{{groupId}}", "expenses"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Balances",
      "item": [
        {
          "name": "Get Balances and Settlements",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Balances fetched', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "if (Array.isArray(data.settlements) && data.settlements.length > 0) {",
                  "  pm.collectionVariables.set('settlementId', data.settlements[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}/balances",
              "host": ["{{baseUrl}}"],
              "path": ["api", "groups", "{{groupId}}", "balances"]
            }
          }
        }
      ]
    },
    {
      "name": "5. AI Parse",
      "item": [
        {
          "name": "Parse Expense Text",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Cab from airport 900 split among 2 people\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}/expenses/parse",
              "host": ["{{baseUrl}}"],
              "path": ["api", "groups", "{{groupId}}", "expenses", "parse"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Settlements",
      "item": [
        {
          "name": "Create Payment Intent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/groups/{{groupId}}/settlements/{{settlementId}}/pay",
              "host": ["{{baseUrl}}"],
              "path": ["api", "groups", "{{groupId}}", "settlements", "{{settlementId}}", "pay"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Webhook",
      "item": [
        {
          "name": "Stripe Webhook (Test)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "stripe-signature", "value": "{{stripeSignature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_test_webhook\",\n  \"object\": \"event\",\n  \"type\": \"payment_intent.succeeded\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"pi_test\",\n      \"metadata\": {\n        \"settlementId\": \"{{settlementId}}\"\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["webhook"]
            }
          }
        }
      ]
    }
  ]
}
