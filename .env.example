# =============================================================================
# SplitUp Backend Environment Configuration
# Copy this file to .env and populate with your credentials.
# NEVER commit the actual .env file or real secrets to version control.
# =============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/splitup?schema=public"

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# AI Expense Parser & Monthly Insights (Google Gemini API)
GOOGLE_AI_API_KEY=your_gemini_api_key_here
GOOGLE_AI_MODEL=gemini-1.5-flash

# MongoDB Persistence (Optional: AI Parse Logs & Audit Trails)
MONGODB_URI=mongodb://localhost:27017/splitup
MONGODB_DB_NAME=splitup

# Email Dispatch & OTP Verification (Nodemailer)
# For Gmail: Use an App Password (16 characters without spaces)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=SplitUp <noreply@splitup.app>
# Optional Custom SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Optional Integrations
CLERK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=INR

# Deployment Self-Ping & Cron URL (for Render / Heroku keep-alive)
RENDER_EXTERNAL_URL=